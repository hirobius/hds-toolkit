{
  "name": "@hirobius/hds-toolkit",
  "version": "0.1.0",
  "description": "Private tooling for the Hirobius Design System: the HDS ESLint plugin, the hds MCP server and the agent docs. The design system itself stays public as @hirobius/design-system.",
  "type": "module",
  "license": "UNLICENSED",
  "private": false,
  "repository": { "type": "git", "url": "git+https://github.com/hirobius/hds-toolkit.git" },
  "publishConfig": { "registry": "https://npm.pkg.github.com" },
  "exports": {
    "./eslint-plugin": { "types": "./eslint-plugin/index.d.mts", "default": "./eslint-plugin/index.mjs" },
    "./package.json": "./package.json"
  },
  "bin": { "hds-mcp": "mcp/hds-mcp.mjs" },
  "files": [
    "eslint-plugin/index.mjs",
    "eslint-plugin/index.d.mts",
    "eslint-plugin/rules/",
    "eslint-plugin/package.json",
    "eslint-plugin/README.md",
    "mcp/",
    "AGENTS.md",
    "llms-full.txt",
    "llms/",
    "SYNCED_FROM.json"
  ],
  "peerDependencies": {
    "@hirobius/design-system": ">=0.26.0",
    "eslint": "^9.0.0 || ^10.0.0"
  },
  "peerDependenciesMeta": { "eslint": { "optional": true } },
  "devDependencies": {
    "@hirobius/design-system": "0.26.2",
    "eslint": "^10.3.0",
    "vitest": "^4.1.0"
  },
  "scripts": {
    "sync": "node scripts/sync-from-hds.mjs",
    "test": "vitest run",
    "prepublishOnly": "node scripts/check-synced.mjs && vitest run"
  },
  "engines": { "node": ">=20" }
}
